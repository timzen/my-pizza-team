// Type-checks the daemon, CLI, shared code, scripts and tests for Node.
//
// Node (>=24) runs these .ts sources directly by stripping types, so every
// option here keeps the code inside what type stripping can run:
// `erasableSyntaxOnly` rejects enums, namespaces and parameter properties, and
// `verbatimModuleSyntax` keeps type-only imports explicit so stripping them
// leaves no dangling runtime import. Imports keep their `.ts` extensions
// (`allowImportingTsExtensions`); `rewriteRelativeImportExtensions` turns them
// into `.js` when the npm package is compiled to dist/ by a separate build
// config. This config only checks.
//
// Modules are checked as ESM with bundler-style resolution rather than `nodenext`.
// Every file here is ESM, but harnesses/pi/ (imported by the tests)
// deliberately has no package.json "type" field — Pi supplies its own loader,
// and Node detects its ESM syntax at runtime. `nodenext` would decide from that
// missing field that those files are CommonJS and reject their `export`s.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "preserve",
    "moduleResolution": "bundler",

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "types": ["node"],

    // The UI's alias for shared/ (ui/tsconfig.app.json), so the ui/src/lib/ modules
    // the tests import type-check here too. Only `import type` uses it — Node can't
    // resolve it at runtime, so runtime imports of shared/ use relative paths.
    "paths": { "@shared/*": ["./shared/*"] }
  },
  "include": [
    "main.ts",
    "plugin/**/*.ts",
    "agent/**/*.ts",
    "cli/**/*.ts",
    "daemon/**/*.ts",
    "runtime/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
