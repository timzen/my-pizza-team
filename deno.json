{
  "version": "0.20.0",
  "tasks": {
    "dev": "deno run --env --allow-net --allow-read --allow-write --allow-env --allow-run --watch daemon/main.ts",
    "start": "deno run --env --allow-net --allow-read --allow-write --allow-env --allow-run daemon/main.ts",
    "mpt": "deno run --env --allow-net --allow-read --allow-write --allow-env --allow-run cli/main.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run --ignore=tests/e2e tests/",
    "test:e2e": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run tests/e2e/",
    "check": "deno check daemon/ cli/ shared/ tests/",
    "sync-version": "deno run --allow-read --allow-write scripts/sync-version.ts",
    "sync-shared": "deno run --allow-read --allow-write scripts/sync-shared.ts",
    "typecheck:ext": "cd harnesses/pi && npm run typecheck",
    "test:ext": "cd harnesses/pi && npm test",
    "ui:dev": "cd ui && npm run dev",
    "ui:build": "cd ui && npm run build",
    "compile": "cd ui && npm run build && cd .. && deno compile --allow-net --allow-read --allow-write --allow-env --allow-run --include ui/dist/ --include harnesses/pi/package.json --include harnesses/pi/src/ --output mpt main.ts",
    "compile:all": "./scripts/build.sh",
    "compile:darwin-arm64": "./scripts/build.sh darwin-arm64",
    "compile:darwin-x64": "./scripts/build.sh darwin-x64",
    "compile:linux-x64": "./scripts/build.sh linux-x64",
    "compile:linux-arm64": "./scripts/build.sh linux-arm64",
    "compile:windows-x64": "./scripts/build.sh windows-x64"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4",
    "hono/": "jsr:@hono/hono@^4/",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
